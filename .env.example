# Flatfinder secrets. Copy this file to ".env" and fill in only what you want.
# EVERYTHING HERE IS OPTIONAL — the app runs with an empty .env.
#
# The launcher creates .env for you automatically on first run, so you usually
# don't need to touch this at all.

# Optional: a free TfL API key raises the journey-planner rate limit.
# The app works WITHOUT a key (keyless requests, lower limit — fine for daily use).
# Add one only if you start seeing "rate limit" warnings.
# Get one at https://api-portal.tfl.gov.uk/
# TFL_APP_KEY=

# Optional: enables the AI quality filter that drops obvious scam / low-quality ads.
# Not required — leave blank to run without any AI. If you add this, also set
# ai.enabled: true in config.yaml. Key from https://platform.deepseek.com/
# DEEPSEEK_API_KEY=

# Optional: residential proxy if SpareRoom rate-limits your IP (http://user:pass@host:port).
# Also set scraper.use_proxy: true in config.yaml when using a proxy.
# PROXY_URL=
